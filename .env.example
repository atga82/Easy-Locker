NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/easy_locker
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h
ACCESS_CODE_SECRET=replace-with-another-random-secret-of-at-least-32-characters
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Only used the first time the development database is seeded.
# Keep these credentials private and never commit .env.
ADMIN_EMAIL=admin@easylocker.local
ADMIN_PASSWORD=replace-with-a-strong-password-of-at-least-12-characters

# For production, replace MONGODB_URI with your MongoDB Atlas connection string.
# Optional: set these only if your network's DNS resolver rejects Atlas SRV lookups.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
